{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personas Schema",
  "description": "JSON schema for personas with ID and Likert scores",
  "type": "object",
  "required": ["personas"],
  "properties": {
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["persona_id", "likert_scores"],
        "properties": {
          "persona_id": {
            "type": "string",
            "pattern": "^P\\d+_[a-z_]+$",
            "description": "Unique persona identifier (e.g., P1_low_concern)"
          },
          "likert_scores": {
            "type": "object",
            "description": "Likert scale scores (1-5) for each statement",
            "patternProperties": {
              ".*": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Likert score value"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

